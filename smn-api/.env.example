# ── SMN tizimiga kirish ma'lumotlari ────────────────────────────────
SMN_BASE_URL=https://smpo-yaat.uzavtoyul.uz
SMN_USERNAME=
SMN_PASSWORD=

# ── Bu API'ning o'z sozlamalari ────────────────────────────────────
PORT=3000
# Ikkinchi loyihangiz shu kalit bilan murojaat qiladi (bo'sh qoldirsangiz himoya o'chadi)
API_KEY=

# Jonli ro'yxat necha soniya kesh qilinsin (SMN'ni ortiqcha yuklamaslik uchun)
CACHE_TTL_SECONDS=15
# Sessiyani tirik ushlab turish oralig'i (daqiqa)
KEEPALIVE_MINUTES=5
# Marshrut nuqtalarini soddalashtirish (0 = barcha nuqta, katta son = kamroq nuqta)
TRACK_EPSILON=0
